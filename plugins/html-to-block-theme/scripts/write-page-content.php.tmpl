<?php
/**
 * write-page-content.php.tmpl — upsert a WordPress page from block markup.
 *
 * write-page.sh stages this file inside the site dir (<site-path>/.h2bt/) after
 * substituting the __PLACEHOLDERS__, alongside the content and title files it
 * references. Run it with:
 *
 *   studio wp eval-file .h2bt/write-<slug>.php --path=<site-path>
 *
 * It echoes exactly one sentinel line — H2BT_OK ... on success, H2BT_FAIL: ...
 * on failure — which the caller greps for. Do not trust the exit code alone.
 *
 * Placeholders (substituted before running; the caller validates every value):
 *   __TITLE_FILE__    basename of a file in this same directory holding the page title
 *   __PAGE_SLUG__     page slug (used for upsert lookup)
 *   __PARENT_PATH__   path of the page this one sits under (about, or about/team), or empty
 *   __TEMPLATE__      page template slug, or "default"
 *   __CONTENT_FILE__  basename of the block-markup file in this same directory
 *   __EXCERPT_FILE__  basename of a file in this same directory holding the excerpt, or
 *                     empty to leave the stored excerpt as it is
 *
 * The title and the excerpt travel in files because they are free text: substituting
 * them into this source corrupts text holding a character the substitution treats specially.
 */

$title_file    = __DIR__ . '/__TITLE_FILE__';
$slug          = '__PAGE_SLUG__';
$parent_path   = '__PARENT_PATH__';
$template      = '__TEMPLATE__';
$content_file  = __DIR__ . '/__CONTENT_FILE__';
$excerpt_name  = '__EXCERPT_FILE__';

if ( ! is_readable( $content_file ) ) {
	echo 'H2BT_FAIL: content file not readable: ' . $content_file . "\n";
	exit;
}

$content = file_get_contents( $content_file );
if ( false === $content || '' === trim( $content ) ) {
	echo "H2BT_FAIL: content file empty\n";
	exit;
}

$title = is_readable( $title_file ) ? file_get_contents( $title_file ) : false;
if ( false === $title || '' === trim( $title ) ) {
	echo 'H2BT_FAIL: title file missing or empty: ' . $title_file . "\n";
	exit;
}
$title = trim( $title );

$excerpt = null;
if ( '' !== $excerpt_name ) {
	$excerpt = is_readable( __DIR__ . '/' . $excerpt_name ) ? file_get_contents( __DIR__ . '/' . $excerpt_name ) : false;
	if ( false === $excerpt ) {
		echo 'H2BT_FAIL: excerpt file not readable: ' . __DIR__ . '/' . $excerpt_name . "\n";
		exit;
	}
	$excerpt = trim( $excerpt );
}

$parent_id = 0;
if ( '' !== $parent_path ) {
	$parent = get_page_by_path( $parent_path, OBJECT, 'page' );
	if ( ! $parent instanceof WP_Post || 'page' !== $parent->post_type ) {
		echo 'H2BT_FAIL: there is no page at "' . $parent_path . '" to put "' . $slug . '" under. Write the parent page first.' . "\n";
		exit;
	}
	$parent_id = $parent->ID;
}
$path = '' === $parent_path ? $slug : $parent_path . '/' . $slug;

// get_page_by_path() also searches attachments, and returns one when no page has the slug.
// Updating that post would turn the media item into a page, so only a page counts as existing.
$existing = get_page_by_path( $path, OBJECT, 'page' );
if ( $existing instanceof WP_Post && 'page' !== $existing->post_type ) {
	echo 'H2BT_FAIL: the slug "' . $slug . '" is held by ' . $existing->post_type . ' ' . $existing->ID . ', so a page cannot take it. Give that post another slug first (wp post update ' . $existing->ID . ' --post_name=<other>), or choose another page slug.' . "\n";
	exit;
}

// A template slug that names no template falls back to the default one without a word.
if ( 'default' !== $template ) {
	if ( wp_is_block_theme() ) {
		$known = array();
		foreach ( get_block_templates( array(), 'wp_template' ) as $block_template ) {
			$known[] = $block_template->slug;
		}
	} else {
		$known = array_keys( wp_get_theme()->get_page_templates( null, 'page' ) );
	}
	if ( ! in_array( $template, $known, true ) ) {
		echo 'H2BT_FAIL: the active theme (' . get_stylesheet() . ') has no template "' . $template . '". Its templates: ' . implode( ', ', $known ) . '. Pass "default" for the default page template.' . "\n";
		exit;
	}
}

// A page whose stored template the active theme does not offer (a page builder's, once the
// builder is switched off) cannot be updated as it is: wp_update_post() carries the stored
// template into the update, and wp_insert_post() rejects it after the content is written. The
// check is the one wp_insert_post() makes. The requested template is stored below.
$replaced_template = '';
if ( $existing instanceof WP_Post ) {
	$stored_before = (string) get_post_meta( $existing->ID, '_wp_page_template', true );
	if ( '' !== $stored_before && 'default' !== $stored_before && ! isset( wp_get_theme()->get_page_templates( $existing )[ $stored_before ] ) ) {
		delete_post_meta( $existing->ID, '_wp_page_template' );
		clean_post_cache( $existing->ID );
		$replaced_template = $stored_before;
	}
}

// Preserve block-delimiter comments and raw markup: drop kses for this write.
kses_remove_filters();

$postarr = array(
	'post_title'   => wp_slash( $title ),
	'post_name'    => $slug,
	'post_status'  => 'publish',
	'post_type'    => 'page',
	'post_parent'  => $parent_id,
	'post_content' => wp_slash( $content ),
);
if ( null !== $excerpt ) {
	$postarr['post_excerpt'] = wp_slash( $excerpt );
}

// WP-CLI runs with no current user, so a page written here would be stored with no author.
$created = ! $existing instanceof WP_Post;
$admins  = get_users(
	array(
		'role'    => 'administrator',
		'number'  => 1,
		'orderby' => 'ID',
		'fields'  => 'ID',
	)
);
if ( $admins && ( $created || 0 === (int) $existing->post_author ) ) {
	$postarr['post_author'] = (int) $admins[0];
}

if ( $created ) {
	$post_id = wp_insert_post( $postarr, true );
} else {
	$postarr['ID'] = $existing->ID;
	$post_id       = wp_update_post( $postarr, true );
}

kses_init_filters();

if ( is_wp_error( $post_id ) || ! $post_id ) {
	$reason = is_wp_error( $post_id ) ? $post_id->get_error_message() : 'unknown error';
	echo 'H2BT_FAIL: ' . $reason . "\n";
	exit;
}

if ( $template && 'default' !== $template ) {
	update_post_meta( $post_id, '_wp_page_template', $template );
} else {
	delete_post_meta( $post_id, '_wp_page_template' );
}

// Read everything back: the sentinel describes what was stored, not what was asked for.
$stored_slug = get_post_field( 'post_name', $post_id, 'raw' );
if ( $stored_slug !== $slug ) {
	// WordPress renames a slug it will not store (a reserved word, or one in use), and the
	// next run would then insert another page. Do not leave the stray page behind.
	if ( $created ) {
		wp_delete_post( $post_id, true );
	}
	echo 'H2BT_FAIL: WordPress would not store the slug "' . $slug . '" (it gave "' . $stored_slug . '")' . ( $created ? '; the page was not kept' : '' ) . ". Choose another slug.\n";
	exit;
}

if ( (int) get_post_field( 'post_parent', $post_id, 'raw' ) !== $parent_id ) {
	echo 'H2BT_FAIL: page ' . $post_id . ' was written, but it is not under "' . $parent_path . "\".\n";
	exit;
}

$stored_title = get_post_field( 'post_title', $post_id, 'raw' );
if ( $stored_title !== $title ) {
	echo 'H2BT_FAIL: page ' . $post_id . ' was written, but its stored title differs from the requested one: ' . $stored_title . "\n";
	exit;
}

$stored_template = (string) get_post_meta( $post_id, '_wp_page_template', true );
if ( $stored_template !== ( 'default' === $template ? '' : $template ) ) {
	echo 'H2BT_FAIL: page ' . $post_id . ' was written, but its stored template is "' . $stored_template . '", not "' . $template . "\".\n";
	exit;
}

if ( null !== $excerpt && get_post_field( 'post_excerpt', $post_id, 'raw' ) !== $excerpt ) {
	echo 'H2BT_FAIL: page ' . $post_id . " was written, but its stored excerpt differs from the requested one.\n";
	exit;
}

$stored_content = (string) get_post_field( 'post_content', $post_id, 'raw' );
if ( $stored_content !== $content ) {
	echo 'H2BT_FAIL: page ' . $post_id . ' was written, but its stored content differs from the source (' . strlen( $content ) . ' bytes given, ' . strlen( $stored_content ) . " stored).\n";
	exit;
}

echo 'H2BT_OK id=' . $post_id . ' slug=' . $stored_slug . ' parent=' . $parent_id . ' template=' . $template . ' bytes=' . strlen( $stored_content ) . ' php=' . PHP_VERSION . ( '' !== $replaced_template ? ' replaced_template=' . $replaced_template : '' ) . "\n";
