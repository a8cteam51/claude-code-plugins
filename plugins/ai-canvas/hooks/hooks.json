{
  "description": "Blocks direct HTTP access to AI-Canvas MCP endpoints — canvas operations must go through the connected MCP tools.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-mcp-endpoint.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
