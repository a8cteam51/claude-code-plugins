{
  "name": "a8cteam51-claude-code-plugins",
  "owner": {
    "name": "Automattic Special Projects",
    "url": "https://specialprojects.automattic.com/"
  },
  "metadata": {
    "description": "Claude Code plugins by Automattic's Special Projects team for WordPress development, security, and client work",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "plugin-review",
      "source": "./plugins/plugin-review",
      "description": "Security review a WordPress plugin by slug, URL, or current directory.",
      "version": "1.0.0",
      "author": {
        "name": "Automattic Special Projects"
      },
      "repository": "https://github.com/a8cteam51/claude-code-plugins",
      "license": "MIT",
      "keywords": ["wordpress", "security", "plugin-review", "vulnerability", "phpcs", "wpscan"],
      "category": "development-tools",
      "strict": true,
      "skills": [
        "./skills/plugin-review"
      ]
    },
    {
      "name": "pr-feedback",
      "source": "./plugins/pr-feedback",
      "description": "Address unresolved PR review comments. Fetches open threads via GitHub GraphQL, evaluates validity, and applies fixes or surfaces questionable feedback for user decision.",
      "version": "1.0.0",
      "author": {
        "name": "Automattic Special Projects"
      },
      "repository": "https://github.com/a8cteam51/claude-code-plugins",
      "license": "MIT",
      "keywords": ["github", "pull-request", "code-review", "feedback", "pr"],
      "category": "development-tools",
      "strict": true,
      "commands": [
        "./commands/pr-addr-feedback.md"
      ]
    }
  ]
}
